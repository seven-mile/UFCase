namespace UFCase
{
    enum FeatureState
    {
        Invalid,
        Unavailable,
        Disabled,
        PartiallyEnabled,
        Enabled,
    };

    [bindable]
    [default_interface]
    runtimeclass FeatureTreeItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        String Name{ get; };
        String Description{ get; };
        String Identity{ get; };
        FeatureState State{ get; };
        String StateText{ get; };

        Windows.Foundation.Collections.IObservableVector<FeatureTreeItem> Children{ get; };

        Boolean IsEnabled{ get; };
        Windows.Foundation.IReference<Boolean> IsChecked{ get; };

        String ModificationMark{ get; set; };
        Microsoft.UI.Xaml.Controls.IconSource Icon{ get; };
    }

    [bindable]
    [default_interface]
    runtimeclass FeatureDetails
    {
        String Name{ get; };
        String Description{ get; };
        String Identity{ get; };
        String DisplayFile{ get; };
        String Restart{ get; };
        String PsfName{ get; };
        String DownloadSize{ get; };
        String SetMembership{ get; };
        String ContentPackageIdentity{ get; };
    }
}
