namespace UFCase
{
    [default_interface]
    runtimeclass ComponentListItem
    {
        String TextForm{ get; };
        String KeyForm{ get; };

        String Name{ get; };
        String Culture{ get; };
        String Version{ get; };
        String PublicKeyToken{ get; };
        String ProcessorArchitecture{ get; };
        String VersionScope{ get; };

        String Status{ get; };
    }

    [default_interface]
    runtimeclass ComponentDetails
    {
        String TextForm{ get; };
        String KeyForm{ get; };

        String Name{ get; };
        String PayloadPath{ get; };
        String Manifest{ get; };
    }
}
